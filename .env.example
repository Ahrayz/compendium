# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- App ---
ENV=local
LOG_LEVEL=INFO

# --- Database ---
# Local: docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres pgvector/pgvector:pg17
# Cloud Run: use the Cloud SQL unix socket form:
#   postgresql://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compendium

# --- Models ---
# Current IDs as of Aug 2026. Do not append date suffixes.
#   claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Vertex/Gemini, if you add it. Uses application default credentials, no key.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1

# --- Cost guardrail ---
# Hard ceiling so a runaway loop can't drain the budget. See telemetry.py.
MAX_COST_USD_PER_DAY=5.0
